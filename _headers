# Security and Performance Headers for GitHub Pages
# This file is processed by Cloudflare or GitHub Pages (if supported)

/*
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=()

  # Content Security Policy (unsafe-inline needed for critical CSS and Tally embed)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://tally.so https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com; img-src 'self' data: https: https://img.shields.io; font-src 'self' data:; connect-src 'self' https://tally.so https://calendly.com; frame-src https://tally.so https://calendly.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://tally.so; upgrade-insecure-requests

  # HSTS (already configured but reinforced here)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Cache Control for Static Assets
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Cache Control for HTML (shorter cache)
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Cache Control for manifest and service worker
/manifest.json
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Cache Control for root files
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400
